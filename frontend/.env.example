# Frontend non-secret configuration only.
# Browser requests use relative paths; Vite proxies these prefixes to the backend.

# Backend origin used by the Vite dev proxy
VITE_BACKEND_PROXY_TARGET=http://localhost:8081

# Optional local dev server port
VITE_DEV_PORT=5173

# Optional public API base path override (leave empty for same-origin relative paths)
VITE_API_BASE_URL=
